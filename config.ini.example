[app]
language = en
session_mode = saved
record_session_audio = false

[api]
# Leave blank until a translation backend is configured in the app.
base_url =
api_key =

[translation]
mode = off
model = gpt-4o-mini
target_lang = Chinese
timeout = 12
threads = 4

[display]
display_duration = 10
window_width = 800
window_height = 120
visible_subtitles = 3
history_limit = 250
original_font_size = 20
translation_font_size = 17
original_color = #ffffff
translation_color = #d99a69
window_opacity = 0.94
display_mode = bilingual

[transcription]
backend = whisper
whisper_model = tiny
funasr_model = iic/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-pytorch
device = cpu
compute_type = int8
enhanced_accuracy = false
accuracy_profile = auto
source_language = auto
transcription_workers = 4

[audio]
input_source = microphone
device_index = auto
sample_rate = 16000
silence_threshold = 0.005
silence_duration = 1.0
noise_gate_mode = balanced
chunk_duration = 0.1
max_phrase_duration = 30
streaming_mode = true
streaming_interval = 3
streaming_step_size = 0.2
update_interval = 0.8
streaming_overlap = 0.3

[v2.4]
# Keep architecture migrations opt-in until enabled by a stable release.
use_translation_scheduler = false
use_sqlite_session_repository = false
